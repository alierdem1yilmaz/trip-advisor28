# VoyageAI environment variables
# Copy this file to .env.local (gitignored) and fill in the values below.

# --- LLM reasoning, explanations & the live "Try VoyageAI" demo ---------
# fal.ai's LLM router (OpenAI-compatible endpoint, proxies GPT/Claude/
# Gemini/etc). Sign up at https://fal.ai (no card for starter credits),
# grab a key from the dashboard. Powers the itinerary-generation demo and
# is the default LLM for the Trip Builder going forward.
FAL_KEY=
# Optional override; defaults to openai/gpt-5. Any model fal's router
# supports works, e.g. anthropic/claude-opus-4.8, google/gemini-3-flash.
FAL_MODEL=
# Optional override for the floating chat widget only; defaults to
# openai/gpt-5-mini (fast/cheap — chat needs to feel snappy).
FAL_CHAT_MODEL=

# --- On hold ---------------------------------------------------------
# Google Gemini direct API. Free tier, but as of writing, freshly created
# Google Cloud projects are hitting a known, widespread Google-side bug
# ("Your project has been denied access") with no fix timeline — see the
# Google AI Developers Forum. Revisit once Google resolves it.
GEMINI_API_KEY=

# Anthropic API key direct (bypassing fal). Sign up at
# https://console.anthropic.com if you'd rather not route through fal.
ANTHROPIC_API_KEY=

# --- Points of interest: attractions, museums, hidden gems --------------
# OpenTripMap. Free tier, request a key at https://opentripmap.io/product
# (click "Get API key", confirm by email). Powers the worldwide POI database
# (tourist attractions, hidden gems, museums, etc.) called for in the vision doc.
OPENTRIPMAP_API_KEY=

# --- Routing, geocoding, isochrones (walking/driving/cycling) -----------
# OpenRouteService. Free tier: 2,500 requests/day, 40,000/month.
# Get a key at https://openrouteservice.org/dev/#/signup
# Powers AI Route Optimization (walking distance, driving time, etc.).
OPENROUTESERVICE_API_KEY=

# --- Secondary map-pin geocoder (optional) ------------------------------
# Foursquare Places API. Free tier covers Place Search/Details with basic
# fields only (name, location, category) — confirmed live: requesting
# rating/tips/photos returns 429 "no API credits remaining", so this does
# NOT unlock reviews or ratings (same wall as Google Places — that needs a
# paid, card-on-file tier regardless of provider). Used only as a fallback
# when OpenTripMap can't resolve a stop's map pin — its commercial/business
# data (cafés, restaurants, shops) fills in small places OpenTripMap misses.
# Get a key at https://foursquare.com/developers (free, no card).
FOURSQUARE_API_KEY=

# --- Weather ---------------------------------------------------------
# Open-Meteo needs NO key at all (free, no signup, no auth) — nothing to set here.
# https://open-meteo.com/en/docs
# Powers Dynamic Weather Planning.

# --- Restaurant reviews & details (optional, add when building Restaurant
# Intelligence) --------------------------------------------------------
# Yelp Fusion API. Free tier (rate-limited). Get a key at
# https://docs.developer.yelp.com/docs/fusion-intro
YELP_API_KEY=

# --- Local events (optional, add when building crowd/event awareness) ---
# Ticketmaster Discovery API. Free tier. Get a key at
# https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
TICKETMASTER_API_KEY=

# --- Database (Supabase Postgres) — the Standard/Pro token system -------
# Create a free project at https://supabase.com, then from Project Settings
# → Database → Connection string: DATABASE_URL is the pooled connection
# (Transaction mode, port 6543, used at runtime); DIRECT_URL is the direct
# connection (port 5432, used only by `prisma migrate`).
DATABASE_URL=
DIRECT_URL=

# --- Auth0 (accounts/sign-in) ---------------------------------------------
# Create a free tenant at https://auth0.com, then Applications → Create
# Application → "Regular Web Application". From its Settings tab, copy the
# Domain/Client ID/Client Secret below, and add:
#   Allowed Callback URLs: http://localhost:3002/auth/callback
#   Allowed Logout URLs:   http://localhost:3002
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Encrypts the session cookie. Generate your own with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3002




