// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// IMPORTANT: this Supabase project's "public" schema is SHARED with other,
// unrelated apps (their tables aren't modeled here at all). Never run
// `prisma migrate dev` or `prisma db push` against it — both try to
// reconcile the *entire* schema and will offer to drop those other apps'
// tables as "drift"/"not in schema". For any future change here, generate
// the SQL with `prisma migrate diff --from-empty --to-schema prisma/schema.prisma
// --script` (safe, doesn't touch the DB) and apply only that statement by
// hand (e.g. via `psql` or a one-off script using DIRECT_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  // The Auth0 user ID ("sub" claim, e.g. "auth0|abc123") — Auth0 owns
  // identity/credentials entirely; this table only tracks the app-specific
  // plan/token state for whoever that identity turns out to be. Provisioned
  // just-in-time the first time we see a given Auth0 session (see
  // src/lib/auth/dal.ts), not at a separate "signup" step.
  auth0Sub      String   @unique
  email         String   @unique
  // "standard" (free, token-limited) | "pro" (unlimited). Plain string
  // rather than an enum — simpler across a provider switch (SQLite has no
  // native enum type; Postgres does, but a CHECK-backed string is one less
  // thing to migrate if this changes).
  plan          String   @default("standard")
  // Remaining free trip-days for the current monthly cycle. Only meaningful
  // for plan = "standard"; ignored (never decremented or checked) for "pro".
  dayTokens     Int      @default(3)
  // When dayTokens next refills to the monthly allowance. Checked lazily on
  // each request rather than via a cron job — no background scheduler in
  // this app, so the reset just happens the next time the user is looked up.
  tokensResetAt DateTime
  createdAt     DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  // Loose reference to User.id, not a Prisma @relation — mirrors this
  // schema's existing style of plain fields over relations. Nullable:
  // feedback can be submitted while signed out too.
  userId    String?
  email     String?
  message   String
  createdAt DateTime @default(now())
}

model PlanRating {
  id          String    @id @default(cuid())
  userId      String
  destination String
  // Snapshot of the preferences used to generate this plan — fed into the
  // personalization prompt block later (see buildPersonalizationBlock in
  // src/lib/itinerary.ts). Plain fields, not a relation, matching this
  // schema's existing style.
  pace        String
  companions  String
  transport   String
  season      String
  interests   String[]
  createdAt   DateTime  @default(now())
  // Null until the traveler responds to the "how was this plan?" prompt
  // shown the day after generation (src/components/PlanRatingPrompt.tsx).
  rating      Int?
  comment     String?
  respondedAt DateTime?
  // Set when the traveler dismisses the prompt without rating — stops it
  // being asked again for this plan. No expiresAt/cron here (unlike
  // SavedTrip): ratings are kept indefinitely as personalization history.
  dismissed   Boolean   @default(false)
}

model VendorClick {
  id          String   @id @default(cuid())
  // Which comparison-site link was clicked (e.g. "Booking.com", "Expedia.com") —
  // this is the raw feed for the Phase 2 export of referrals-per-site.
  vendor      String
  hotelName   String
  destination String
  createdAt   DateTime @default(now())
}

model SavedTrip {
  id        String   @id @default(cuid())
  userId    String
  // "saved" (user clicked "Save trip", 7-day lifetime, extendable) |
  // "history" (auto-recorded on every generation the user never explicitly
  // saved, 1-day lifetime, not extendable/deletable — a passive log, not a
  // managed collection). Plain string, not an enum, matching this schema's
  // existing style.
  kind      String   @default("saved")
  // The full PlanResponse (destination, center, days[]) from /api/plan,
  // stored as-is — no need to normalize into separate day/stop tables for
  // a read-mostly bookmark feature.
  plan      Json
  createdAt DateTime @default(now())
  // Auto-deleted by the daily cron (src/app/api/cron/expire-saved-trips)
  // once this passes; extending (kind="saved" only) resets it forward again.
  expiresAt DateTime
}
